{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '\"SESSION_ID=\" + .session_id'"
                    }
                ]
            }
        ]
    }
}
